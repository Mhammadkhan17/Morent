# Copy to backend/.env and fill in real values.
# Never commit backend/.env.

# Neon Postgres
# Pooled (‑pooler host) — app traffic via async engine
DATABASE_URL=postgresql://user:password@<endpoint>-pooler.<region>.aws.neon.tech/dbname?sslmode=require&channel_binding=require
# Direct (no -pooler) — Alembic migrations only
DATABASE_URL_UNPOOLED=postgresql://user:password@<endpoint>.<region>.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# Origins — AUTH_BASE_URL must equal frontend BETTER_AUTH_URL exactly (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000
AUTH_BASE_URL=http://localhost:3000
